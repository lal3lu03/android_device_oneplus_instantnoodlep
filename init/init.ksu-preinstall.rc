# KernelSU module pre-installer — runs once on first boot after flash.
# On subsequent boots the flag file /data/adb/.ksu-preinstalled prevents re-execution.
# After installation KernelSU loads the modules on the NEXT reboot.
#
# Placed in post-fs-data so /data/adb/ is already mounted.

on post-fs-data
    exec_background u:r:vendor_qti_init_shell:s0 -- /vendor/bin/ksu-preinstall.sh
