# KernelSU SELinux policy additions
#
# Allows the pre-install shell script (vendor_qti_init_shell domain) to:
#   - Read module ZIPs and config from /vendor/etc/ksu-preinstall/
#   - Write module directories to /data/adb/modules/
#   - Write TrickyStore config to /data/adb/tricky_store/
#   - Read/write the guard flag /data/adb/.ksu-preinstalled

# vendor_qti_init_shell already has access to vendor_file and shell_exec.
# Do NOT grant adb_data_file access here; vendor domains writing /data/adb
# violate platform neverallow rules and break userdebug/user builds.
#
# Keep only unzip execution permission for optional debug flows.
userdebug_or_eng(`
  allow vendor_qti_init_shell toolbox_exec:file { read execute open execute_no_trans };
')
