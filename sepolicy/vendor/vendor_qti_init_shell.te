# sensor_recover.sh runs in vendor_qti_init_shell and must maintain
# /mnt/vendor/persist/sensors registry files used by the sensors stack.
allow vendor_qti_init_shell mnt_vendor_file:dir search;
create_dir_file(vendor_qti_init_shell, vendor_persist_sensors_file)
rw_dir_file(vendor_qti_init_shell, vendor_persist_sensors_file)
allow vendor_qti_init_shell vendor_persist_sensors_file:file setattr;
